# --- Claude ---------------------------------------------------------------
# Única credencial de servidor del asistente. Nunca llega al navegador.
# Es lo ÚNICO obligatorio para que POST /chat funcione.
ANTHROPIC_API_KEY=

# --- Orígenes permitidos (CORS) ------------------------------------------
# Lista separada por comas con los dominios de los ERPs. Vacío = ningún
# navegador puede llamar a la API.
VORTA_ALLOWED_ORIGINS=http://localhost:5173

# --- Credenciales de los sistemas ----------------------------------------
# NO van aquí. La URL y la anon key de cada ERP viven en
# apps/api/src/systems/<slug>.ts: son públicas (el frontend de cada ERP ya las
# trae embebidas) y por sí solas no dan acceso a nada, porque toda lectura va
# con el JWT del usuario y RLS decide.
#
# La service role key no se usa nunca para leer datos del cliente, así que no
# aparece en este archivo ni en ningún otro.

# --- Pruebas locales, opcional (scripts/dev-chat.ts) ---------------------
# Solo si quieres probar POST /chat sin UI: el script hace login con este
# usuario contra el Supabase del sistema para obtener un JWT real. Si los dejas
# vacíos, el script no corre y no pasa nada más.
TEST_EMAIL=
TEST_PASSWORD=
