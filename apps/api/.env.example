# --- Claude ---------------------------------------------------------------
# Única credencial de servidor del asistente. Nunca llega al navegador.
ANTHROPIC_API_KEY=

# --- Orígenes permitidos (CORS) ------------------------------------------
# Lista separada por comas con los dominios de los ERPs.
VORTA_ALLOWED_ORIGINS=http://localhost:5173

# --- Sistema piloto: ACM (Abastecedora de Carnes Magaña) ------------------
# Solo URL + anon key. El asistente lee con el JWT del usuario para que RLS
# aplique; la service role key NO se usa para leer datos del cliente y por eso
# no aparece en este archivo.
ACM_SUPABASE_URL=
ACM_SUPABASE_ANON_KEY=

# --- Sistemas 2..8 (se agregan en la Fase 7) -----------------------------
# <SISTEMA>_SUPABASE_URL=
# <SISTEMA>_SUPABASE_ANON_KEY=
